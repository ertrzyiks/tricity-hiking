---
import { getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import CityTimeline, {
  type TimelineEvent,
} from "../../components/history/CityTimeline.astro";
import HistoryCityTabs from "../../components/history/HistoryCityTabs.astro";
import HistoryTimelineLegend from "../../components/history/HistoryTimelineLegend.astro";
import Admonition from "../../components/ui/Admonition.astro";
import { GermanNamesMap } from "../../components/ui/GermanNamesMap/GermanNamesMap";
import { MapLoadingSpinner } from "../../components/ui/MapLoadingSpinner/MapLoadingSpinner";

const germanNamesEntry = await getEntry("german_names", "names");

if (!germanNamesEntry) {
  throw new Error("Missing german_names geodata");
}

const sopotFeatures = germanNamesEntry.data.features.filter(
  (feature) =>
    (feature.properties.category === "street name" ||
      feature.properties.category === "valley name") &&
    feature.properties.city === "Sopot",
);

const sopotMappedStreetCount = sopotFeatures.filter(
  (feature) =>
    feature.properties.category === "street name" && feature.geometry !== null,
).length;

const sopotMappable = {
  type: "FeatureCollection" as const,
  features: sopotFeatures.filter((feature) => feature.geometry !== null),
} as GeoJSON.FeatureCollection;

const sopotUnmapped = sopotFeatures.filter(
  (feature) => feature.geometry === null && feature.properties.exists,
);

const timelineConfig: TimelineEvent[] = [
  {
    year: 1283,
    event: "First record of Sopoth",
    label: "Pomerelian dukes",
    description:
      "The Pomerelian duke Mściwój II gives the small fishing village to the Cistercian monks of Oliwa.",
  },
  {
    year: 1308,
    event: "Danzig massacre",
    label: "Teutonic Order",
    description:
      "Teutonic Order takes over Danzig. Sopot comes under Teutonic rule, while remaining the property of the Cistercian monastery of Oliwa.",
  },
  {
    year: 1454,
    event: "Danzig rebellion",
    label: "Poland",
  },
  {
    year: 1772,
    event: "First Partition of Poland",
    label: "Prussia",
    description: "Sopot is annexed by the Kingdom of Prussia.",
  },
  {
    year: 1823,
    event: "Haffner opens the first bathing house",
    label: "Prussia",
    minor: true,
  },
  {
    year: 1901,
    event: "City rights granted",
    label: "Prussia",
    minor: true,
  },
  {
    year: 1920,
    event: "Treaty of Versailles",
    label: "Free City (Versailles)",
  },
  {
    year: 1939,
    event: "Invasion of Poland",
    label: "Nazi Germany",
  },
  {
    year: 1945,
    event: "Liberation of Sopot",
    label: "Poland",
  },
];
---

<Layout title={`Overview of the major events in the history of Sopot`}>
  <PageTitle title="History of Sopot" slot="hero" />

  <div class="max-w-(--breakpoint-xl) mx-auto py-4 px-2 lg:px-0">
    <HistoryCityTabs />

    <p class="text-lg my-4">
      The timeline below presents the key events in the history of Sopot, from a
      small fishing village to Poland's best-known seaside resort.
    </p>

    <HistoryTimelineLegend />

    <CityTimeline events={timelineConfig} />

    <h3 class="text-2xl my-4">Old German street and valley names</h3>

    <p class="text-lg my-2">
      Curious what today's streets used to be called before 1945? This overlay
      places {sopotMappedStreetCount} old German street names on today's map, along
      with the old names of a few valleys in the Sopot forests. Click a line or dot
      to see the old name next to the current one.
    </p>

    <Admonition type="info" title="About the data">
      Streets are shown as lines. Valleys are shown as small black dots, or as a
      dotted line where the valley floor is mapped. Looking for Gdańsk's old
      street and district names, or the wider region's old town names? See the <a
        class="hover:underline text-blue-600"
        href="/history/">Gdańsk</a
      > history page or the <a
        class="hover:underline text-blue-600"
        href="/history/german-names/">City names</a
      > tab.
    </Admonition>

    <figure class="my-4 relative h-[50vh]">
      <div
        aria-hidden="true"
        class="absolute inset-0 flex items-center justify-center pointer-events-none bg-slate-100"
      >
        <MapLoadingSpinner />
      </div>

      <GermanNamesMap
        client:only="preact"
        data={sopotMappable}
        categories={["street name", "valley name"]}
        center={[18.549, 54.4404]}
        zoom={14}
        minZoom={12}
        maxZoom={18}
      />

      <figcaption class="text-base text-slate-500 text-center my-2">
        Old German street and valley names overlaid on today's Sopot
      </figcaption>
    </figure>

    {
      sopotUnmapped.length > 0 && (
        <details class="my-6 text-sm text-slate-600">
          <summary class="cursor-pointer font-bold text-slate-700">
            {sopotUnmapped.length} names couldn't be placed on the map for some
            reason
          </summary>
          <ul class="list-disc list-inside mt-2 columns-1 sm:columns-2 lg:columns-3 gap-4">
            {sopotUnmapped.map((feature) => (
              <li>
                {feature.properties.german} &rarr; {feature.properties.polish}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</Layout>

<style is:global>
  .maplibregl-map {
    height: 100%;
    width: 100%;
  }
</style>
