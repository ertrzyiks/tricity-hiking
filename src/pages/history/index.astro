---
import { getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CityTimeline, {
  type TimelineEvent,
} from "../../components/history/CityTimeline.astro";
import HistoryCityTabs from "../../components/history/HistoryCityTabs.astro";
import HistoryTimelineLegend from "../../components/history/HistoryTimelineLegend.astro";
import Admonition from "../../components/ui/Admonition.astro";
import { GermanNamesMap } from "../../components/ui/GermanNamesMap/GermanNamesMap";
import { MapLoadingSpinner } from "../../components/ui/MapLoadingSpinner/MapLoadingSpinner";

const germanNamesEntry = await getEntry("german_names", "names");

if (!germanNamesEntry) {
  throw new Error("Missing german_names geodata");
}

// Gdańsk's slice of the old-names overlay: its streets/squares plus every
// district (districts in the source are Gdańsk-only, so no city filter is
// needed for those).
const gdanskFeatures = germanNamesEntry.data.features.filter(
  (feature) =>
    feature.properties.category === "district name" ||
    (feature.properties.category === "street name" &&
      feature.properties.city === "Gdańsk"),
);

const gdanskMappable = {
  type: "FeatureCollection" as const,
  features: gdanskFeatures.filter((feature) => feature.geometry !== null),
} as GeoJSON.FeatureCollection;

const gdanskUnmapped = gdanskFeatures.filter(
  (feature) => feature.geometry === null && feature.properties.exists,
);

const timelineConfig: TimelineEvent[] = [
  {
    year: 997,
    event: "First record of GYDDANYZC",
    label: "Mostly Pomerelian dukes",
  },
  {
    year: 1263,
    event: "City rights granted",
    label: "Pomerelian dukes",
    minor: true,
  },
  {
    year: 1308,
    event: "Danzig massacre",
    label: "Teutonic Order",
    description:
      "Teutonic Order helps to relieve Danzing from a siege, but the ally quickly turns into an enemy and takes over the city.",
  },
  {
    year: 1410,
    event: "Battle of Grunwald",
    description:
      "Danzig pays homage to Polish King, but returns to Teutonic control a couple months after",
    label: "Teutonic Order",
    minor: true,
  },
  {
    year: 1454,
    event: "Danzig rebellion",
    label: "Poland",
    description:
      "Danzig rebels against the Teutonic Order and soon after supports Polish king in the Thirteen Years' War.",
  },
  {
    year: 1793,
    event: "Second Partition of Poland",
    label: "Prussia",
    description:
      "The annexation of Polish territories by Russia and Prussia occurs as a result of the lost Russo-Polish war a year earlier. The citizens of Gdańsk try to resist the new Prussian authorities, but they are quickly suppressed.",
  },
  {
    year: 1807,
    event: "Siege of Danzig",
    label: "Free City (Napoleonic)",
    description:
      "Napoleon's Grande Armee captures Danzig and establishes the Free City of Danzig as a semi-autonomous state under French protection.",
  },
  {
    year: 1814,
    event: "Siege of Danzig",
    label: "Prussia",
    description:
      "The Siege of Danzig (1813-1814) ends with the surrender of the French garrison, and the city returns to Prussian rule.",
  },
  {
    year: 1871,
    event: "Unification of Germany",
    label: "German Empire",
    description: "King of Prussia is proclaimed German Emperor",
    minor: true,
  },
  {
    year: 1918,
    event: "Weimar Republic is established",
    label: "Weimar Republic",
    description: "The German Empire collapses in the aftermath of World War I",
    minor: true,
  },
  {
    year: 1920,
    event: "Treaty of Versailles",
    label: "Free City (Versailles)",
    description:
      "After two years of debate over Danzig's fate, the Free City of Danzig is established. It is self-governing but placed under the protection of the League of Nations.",
  },
  {
    year: 1939,
    event: "Invasion of Poland",
    label: "Nazi Germany",
  },
  {
    year: 1945,
    event: "Liberation of Danzig",
    label: "Poland",
  },
];
---

<Layout title={`Overview of the major events in the history of Gdańsk`}>
  <div class="max-w-(--breakpoint-xl) mx-auto py-4 px-2 lg:px-0">
    <h2 class="text-3xl my-4">History</h2>

    <HistoryCityTabs />

    <p class="text-lg my-4">
      The timeline below presents the key events in the history of Gdańsk.
    </p>

    <HistoryTimelineLegend />

    <CityTimeline events={timelineConfig} />

    <h3 class="text-2xl my-4">Old German street and district names</h3>

    <p class="text-lg my-2">
      Curious what today's streets and districts used to be called before 1945?
      This overlay places {gdanskMappable.features.length} old German names on today's
      map. Click a line, shape, or dot to see the old name next to the current one.
    </p>

    <Admonition type="info" title="About the data">
      Streets are shown as lines. Districts are shown as shaded areas where a
      present-day boundary exists, otherwise as a dot. Looking for Sopot's old
      street names, or the wider region's old town names? See the <a
        class="hover:underline text-blue-600"
        href="/history/sopot/">Sopot</a
      > history page or the <a
        class="hover:underline text-blue-600"
        href="/history/german-names/">City names</a
      > tab.
    </Admonition>

    <figure class="my-4 relative h-[50vh]">
      <div
        aria-hidden="true"
        class="absolute inset-0 flex items-center justify-center pointer-events-none bg-slate-100"
      >
        <MapLoadingSpinner />
      </div>

      <GermanNamesMap
        client:only="preact"
        data={gdanskMappable}
        categories={["district name", "street name"]}
        center={[18.63, 54.365]}
        zoom={12}
        minZoom={10}
        maxZoom={18}
      />

      <figcaption class="text-base text-slate-500 text-center my-2">
        Old German street and district names overlaid on today's Gdańsk
      </figcaption>
    </figure>

    {
      gdanskUnmapped.length > 0 && (
        <details class="my-6 text-sm text-slate-600">
          <summary class="cursor-pointer font-bold text-slate-700">
            {gdanskUnmapped.length} names couldn't be placed on the map for some
            reason
          </summary>
          <ul class="list-disc list-inside mt-2 columns-1 sm:columns-2 lg:columns-3 gap-4">
            {gdanskUnmapped.map((feature) => (
              <li>
                {feature.properties.german} &rarr; {feature.properties.polish}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</Layout>

<style is:global>
  .maplibregl-map {
    height: 100%;
    width: 100%;
  }
</style>
