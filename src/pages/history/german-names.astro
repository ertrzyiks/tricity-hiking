---
import { getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import Admonition from "../../components/ui/Admonition.astro";
import HistoryCityTabs from "../../components/history/HistoryCityTabs.astro";
import { GermanNamesMap } from "../../components/ui/GermanNamesMap/GermanNamesMap";
import { MapLoadingSpinner } from "../../components/ui/MapLoadingSpinner/MapLoadingSpinner";

const entry = await getEntry("german_names", "names");

if (!entry) {
  throw new Error("Missing german_names geodata");
}

// This page covers only town/village names across the wider region - the
// street and district overlays for Gdańsk and Sopot live inline on their
// own history pages instead.
const localities = entry.data.features.filter(
  (feature) => feature.properties.category === "locality name",
);

// Only features we could actually place on the map - a handful of names
// from the book couldn't be matched to a present-day OSM feature.
const mappable = {
  type: "FeatureCollection" as const,
  features: localities.filter((feature) => feature.geometry !== null),
} as GeoJSON.FeatureCollection;

const unmapped = localities.filter(
  (feature) => feature.geometry === null && feature.properties.exists,
);
---

<Layout title="Old German names of towns and villages across the region">
  <PageTitle title="Old German city names" slot="hero" />

  <div class="max-w-(--breakpoint-xl) mx-auto py-4 px-2 lg:px-0">
    <HistoryCityTabs />

    <p class="text-lg my-2">
      For many years until 1945, significant part of today's northern Poland
      used German names for its towns and villages. This overlay places them on
      today's map. Click a shape or dot to see the old name next to the current
      one.
    </p>

    <Admonition type="info" title="About the data">
      Towns and villages are shown as shaded areas where a present-day boundary
      exists, otherwise as a dot.
      {
        import.meta.env.DEV && (
          <>
            {" "}
            <a class="hover:underline text-blue-600" href="/dev/german-names/">
              Edit this data &rarr;
            </a>
          </>
        )
      }
    </Admonition>

    <figure class="my-4 relative h-[70vh]">
      <div
        aria-hidden="true"
        class="absolute inset-0 flex items-center justify-center pointer-events-none bg-slate-100"
      >
        <MapLoadingSpinner />
      </div>

      <GermanNamesMap
        client:only="preact"
        data={mappable}
        categories={["locality name"]}
        center={[17.99, 53.8]}
        zoom={6.8}
        minZoom={6}
        maxZoom={14}
      />

      <figcaption class="text-base text-slate-500 text-center my-2">
        Old German names overlaid on the current map
      </figcaption>
    </figure>

    {
      unmapped.length > 0 && (
        <details class="my-6 text-sm text-slate-600">
          <summary class="cursor-pointer font-bold text-slate-700">
            {unmapped.length} names couldn't be placed on the map for some
            reason
          </summary>
          <ul class="list-disc list-inside mt-2 columns-1 sm:columns-2 lg:columns-3 gap-4">
            {unmapped.map((feature) => (
              <li>
                {feature.properties.german} &rarr; {feature.properties.polish}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</Layout>

<style is:global>
  .maplibregl-map {
    height: 100%;
    width: 100%;
  }
</style>
