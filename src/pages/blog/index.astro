---
import Layout from "../../layouts/Layout.astro";
import ListCardItem from "../../components/ui/ListCardItem.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import wielkaGwiazda from "../../assets/photos/wielka-gwiazda.jpg";
import lysaGora from "../../assets/photos/lysa-gora.jpg";

const order = [
  "the-best-hiking-trails-near-gdansk",
  "top-sights",
  "hidden-gems",
  "things-to-do-in-gdansk-with-kids",
  "orienteering",
  "fairs",
];

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => {
    const rankA = order.indexOf(a.id) !== -1 ? order.indexOf(a.id) : 100;
    const rankB = order.indexOf(b.id) !== -1 ? order.indexOf(b.id) : 100;
    return rankA - rankB;
  },
);
---

<Layout title="Articles - Tricity Hiking">
  <div class="max-w-(--breakpoint-xl) mx-auto relative px-2 lg:px-0">
    <ul class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-x-12">
      {
        posts.map((post) => (
          <ListCardItem link={`/blog/${post.id}/`} outlined>
            <Image
              src={
                post.id === "the-best-hiking-trails-near-gdansk"
                  ? wielkaGwiazda
                  : lysaGora
              }
              width="160"
              height="160"
              class="w-16 h-16 object-cover"
              alt={`Photo for ${post.data.title}`}
              slot="image"
            />
            <span class="group-hover:text-green-600" slot="title">
              {post.data.title}
            </span>
            <span class="group-hover:text-green-600" slot="description">
              {post.data.listDescription ?? post.data.description}
            </span>
          </ListCardItem>
        ))
      }
    </ul>
  </div>
</Layout>
