---
import Layout from "../../layouts/Layout.astro";
import { GermanNamesEditor } from "../../components/ui/GermanNamesEditor/GermanNamesEditor";
---

<Layout title="German names editor (dev)">
  <div class="max-w-(--breakpoint-xl) mx-auto py-4 px-2 lg:px-0">
    <h2 class="text-3xl my-4">German names editor</h2>
    <p class="text-slate-600 my-2">
      Dev-only tool for reviewing and fixing entries in the <code
        >german_names</code
      > content collection. Changes save straight to <code
        >src/content/german_names/names.json</code
      > - rerun the map page to see them.
    </p>

    <GermanNamesEditor client:only="preact" />
  </div>
</Layout>
