---
// Single continuous scroll homepage — prototype for issue #3 of the
// new-ui-prototypes map (single scroll, no page nav). Resolved spec lives in
// the project's local UI-prototypes tracker at
// .scratch/new-ui-prototypes/issues/03-single-scroll-no-nav.md (untracked —
// ask the team for it if that path is missing on your checkout).
//
// Every section below is a summary of an existing standalone page, with a
// "See more" link out to it. The standalone pages (/routes, /list,
// /activities, /food, /history) stay live and unchanged — this page is an
// additive front door, not a replacement for them content-wise.
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/ui/Hero.astro";
import { AnchorNav } from "../components/ui/AnchorNav/AnchorNav";
import AnchorSection from "../components/ui/AnchorNav/AnchorSection.astro";
import { HomeMap } from "../components/ui/HomeMap/HomeMap";
import RouteMapLegend from "../components/ui/RouteMapLegend.astro";
import RouteListItem from "../components/ui/ListCardItem/Route.astro";
import ActivityList from "../components/ui/ActivitiesList/ActivityList.astro";
import FoodListCardItem from "../components/ui/ListCardItem/Food.astro";
import TimelineRoot from "../components/ui/Timeline/Timeline.astro";
import TimelineItem from "../components/ui/Timeline/TimelineItem.astro";
import TimelineOppositeContent from "../components/ui/Timeline/TimelineOppositeContent.astro";
import TimelineOppositeContentSecondary from "../components/ui/Timeline/TimelineOppositeContentSecondary.astro";
import TimelineSeparator from "../components/ui/Timeline/TimelineSeparator.astro";
import TimelineDot from "../components/ui/Timeline/TimelineDot.astro";
import TimelineConnector from "../components/ui/Timeline/TimelineConnector.astro";
import TimelineContent from "../components/ui/Timeline/TimelineContent.astro";
import TimelineContentLabel from "../components/ui/Timeline/TimelineContentLabel.astro";
import { enhance } from "../services/enhance";
import { merge } from "../services/merge";
import { getLineStringFeature } from "../services/getLineStringFeature";
import { foodCategoryIcons, foodPlaces, type FoodPlace } from "../data/foodPlaces";
import { timelineConfig, processTimeline } from "../data/historyTimeline";
import TricityMap from "../assets/tricity.svg";
import mapImage from "../assets/home-map.jpg";
import { Icon } from "astro-icon/components";

const allRoutes = await getCollection("routes");
const routes = allRoutes.filter((route) => !route.data.draft);

// Map section — same "tricity" query as /routes, reused as-is.
const tricityRoutes = routes.filter((route) => route.data.tricity);
const mapGeojsonList = [];
for (const route of tricityRoutes) {
  const geojson = await getEntry(route.data.geojson);
  mapGeojsonList.push(enhance({ collection: geojson.data, route: route.data }));
}
const mapGeojson = merge(mapGeojsonList);

// Routes section — same "featured: homepage" query as today's index.astro.
const featuredRoutes = routes
  .filter((route) => route.data.featured === "homepage")
  .slice(0, 3);
const featuredRouteCards = [];
for (const route of featuredRoutes) {
  const geojson = await getEntry(route.data.geojson);
  const enhancedGeojson = enhance({ collection: geojson.data, route: route.data });
  featuredRouteCards.push({
    route,
    properties:
      getLineStringFeature({ collection: enhancedGeojson })?.properties ?? {},
  });
}

// Activities section — same ActivityList component as /activities, just fed
// a handful of picks instead of the full collection.
const allActivities = await getCollection(
  "activities",
  ({ data }) => !data.draft,
);
const activityPicks = allActivities.slice(0, 6);

// Food section — one sample per category, same data as /food.
const foodPicks = ["Breakfast", "Lunch/Dinner", "Cafe"]
  .map((kind) => foodPlaces.find((place) => place.kind === kind))
  .filter((place): place is FoodPlace => place !== undefined);

// History section — same <Timeline> as /history, "collapsed" to major
// events only. Filtering before processTimeline() means each bar's duration
// is the gap to the *next major event*, not a hidden minor one, so the
// shorter timeline still reads correctly on its own.
const majorTimeline = processTimeline(
  timelineConfig.filter((event) => !event.minor),
);
---

<Layout title="List of the best hiking trails near Gdańsk, Sopot, and Gdynia">
  <Hero
    title="Step into Tricity"
    description="Plan your next adventure in Tricity with our handpicked hiking routes, local tips, and hidden gems. "
    slot="hero"
  />

  <div class="bg-white">
    <div
      class="max-w-(--breakpoint-xl) mx-auto relative px-2 lg:px-0 py-12 lg:py-16"
    >
      <h2 class="text-2xl mb-8">Tricity</h2>

      <div
        class="flex flex-col lg:flex-row gap-4 lg:gap-16 items-center md:px-12 lg:px-16"
      >
        <div>
          <TricityMap class="w-56 h-56" />
        </div>
        <div class="px-2 lg:px-0">
          <p class="text-slate-700">
            Tricity—made up of Gdańsk, Sopot, and Gdynia—is a unique region in
            northern Poland where the Baltic Sea meets the gentle hills of the
            Tricity Landscape Park. From the medieval streets of Gdańsk to the
            vibrant pier of Sopot and the modern charm of Gdynia, Tricity
            blends nature, history, and coastal life in one inviting
            destination.
          </p>
        </div>
      </div>

      <div class="mt-16">
        <h2 class="text-2xl mb-8">Why?</h2>

        <div class="flex flex-col lg:flex-row gap-8">
          <div class="flex-1 bg-slate-50 p-8 rounded-lg shadow-lg">
            <div class="flex items-center gap-2">
              <Icon name="mdi:forest" class="w-6 h-6" />
              <h3 class="text-lg font-bold">Explore Nature</h3>
            </div>
            <p class="text-slate-700 mt-4">
              Almost 200,000 square meters of landscape protected area. The
              terrain is pleasantly varied, offering forest trails,
              occasional viewpoints, and a refreshing break from flat
              cityscapes.
            </p>
          </div>

          <div class="flex-1 bg-slate-50 p-8 rounded-lg shadow-lg">
            <div class="flex items-center gap-2">
              <Icon name="mdi:museum" class="w-6 h-6" />
              <h3 class="text-lg font-bold">Unearth a Rich History</h3>
            </div>
            <p class="text-slate-700 mt-4">
              With over 1,000 years of history in Gdańsk, the charming
              seaside town of Sopot, which has attracted visitors since the
              19th century, and the rise of Gdynia in the 20th century,
              traces of history are everywhere.
            </p>
          </div>
          <div class="flex-1 bg-slate-50 p-8 rounded-lg shadow-lg">
            <div class="flex items-center gap-2">
              <Icon name="mdi:local-restaurant" class="w-6 h-6" />
              <h3 class="text-lg font-bold">Take a Break</h3>
            </div>
            <p class="text-slate-700 mt-4">
              After a long day of hiking, you can relax in one of the many
              restaurants or cafes. Tricity offers a wide range of dining
              options, where you can unwind and enjoy the local culture.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <AnchorNav client:visible />

  <AnchorSection id="map" background="slate">
    <h2 class="text-2xl mb-8">Map</h2>

    <div class="relative h-[60vh] lg:h-[65vh]" transition:name="map">
      <div class="absolute inset-0 h-full overflow-hidden">
        <img src={mapImage.src} class="absolute blur-2xl inset-0 h-full" />
      </div>

      {
        /*
          Every other page mounts HomeMap with client:only="preact" (it
          renders nothing server-side and hydrates immediately). Here it's
          client:visible instead — required by the spec so this map/chart-
          heavy island only pays its hydration cost once scrolled into view,
          now that it's sharing the page load with four other sections.
        */
      }
      <HomeMap client:visible routes={mapGeojson} />
    </div>

    <RouteMapLegend />

    <a
      class="px-4 py-2 rounded-md border border-solid bg-green-50 hover:bg-green-200 text-slate-900 border-green-300 inline-block"
      href="/extended/"
    >
      Include nearby routes
    </a>
  </AnchorSection>

  <AnchorSection id="routes">
    <h2 class="text-2xl mb-8">Routes</h2>

    <ul>
      {
        featuredRouteCards.map(({ route, properties }) => (
          <RouteListItem route={route} properties={properties} />
        ))
      }
    </ul>

    <div class="flex flex-wrap gap-x-6 gap-y-2 mt-2">
      <a class="simple-link" href="/routes">See all routes on the map →</a>
      <a class="simple-link" href="/list">Browse all routes as a list →</a>
    </div>
  </AnchorSection>

  <AnchorSection id="activities" background="slate">
    <h2 class="text-2xl mb-8">Activities</h2>

    <ActivityList activities={activityPicks} groupBy="category" />

    <a class="simple-link" href="/activities">See all activities →</a>
  </AnchorSection>

  <AnchorSection id="food">
    <h2 class="text-2xl mb-8">Food</h2>

    <div class="flex flex-wrap gap-4 mb-8">
      {
        Object.entries(foodCategoryIcons).map(([category, icon]) => (
          <div class="flex items-center gap-2 text-slate-700 bg-slate-50 rounded-full px-4 py-2">
            <Icon name={icon} class="w-5 h-5" />
            {category}
          </div>
        ))
      }
    </div>

    <ul>
      {
        foodPicks.map((place) => (
          <FoodListCardItem
            link={place.link}
            name={place.name}
            location={place.location}
            icon={foodCategoryIcons[place.kind]}
          />
        ))
      }
    </ul>

    <a class="simple-link" href="/food">See all recommended places →</a>
  </AnchorSection>

  <AnchorSection id="history" background="slate">
    <h2 class="text-2xl mb-8">History</h2>

    <TimelineRoot>
      <TimelineItem>
        <TimelineSeparator slot="separator">
          <TimelineConnector />
        </TimelineSeparator>
      </TimelineItem>
      {
        majorTimeline.map((item) => (
          <TimelineItem key={item.year} height={40 + item.duration * 0.4}>
            <TimelineOppositeContent slot="opposite-content">
              {item.event}

              {item.description && (
                <TimelineOppositeContentSecondary>
                  {item.description}
                </TimelineOppositeContentSecondary>
              )}
            </TimelineOppositeContent>
            <TimelineSeparator slot="separator">
              <TimelineDot variant="regular" />
              <TimelineConnector />
            </TimelineSeparator>
            <TimelineContent slot="content">
              {item.year}
              {item.label && (
                <TimelineContentLabel>{item.label}</TimelineContentLabel>
              )}
            </TimelineContent>
          </TimelineItem>
        ))
      }
    </TimelineRoot>

    <a class="simple-link mt-6 inline-block" href="/history">
      See the full timeline →
    </a>
  </AnchorSection>
</Layout>

<style is:global>
  .maplibregl-map {
    height: 100%;
    width: 100%;
  }
</style>
