---
import type { InferGetStaticParamsType } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { RouteMap } from "../../../components/ui/RouteMap/RouteMap";
import { MapLoadingSpinner } from "../../../components/ui/MapLoadingSpinner/MapLoadingSpinner";
import { FullElevationChart } from "../../../components/ui/FullElevationChart/FullElevationChart";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const allRoutes = await getCollection("routes");

  const routes = allRoutes.filter((route) => {
    return !route.data.draft;
  });

  return routes.map((route) => {
    return {
      params: {
        route: route.id,
      },
    };
  });
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { route } = Astro.params as Params;

const entry = await getEntry("routes", route);

if (!entry) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return;
}

const geojson = await getEntry(entry.data.geojson);
const { Content } = await render(entry);

const attitudes = geojson.data.features[0].geometry.coordinates
  .map((coord) => {
    if (!Array.isArray(coord)) {
      return null;
    }
    return coord[2];
  })
  .filter((coords): coords is number => Boolean(coords));

const feature = geojson.data.features.find(
  (feature) => feature.geometry.type === "LineString",
);

if (!feature) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return;
}
---

<Layout
  title={`${entry.data.title}`}
  description={entry.data.htmlDescription ?? entry.data.description}
>
  <div
    class="mx-auto relative h-[calc(100vh-190px)] px-2 lg:px-0"
    transition:name="map"
  >
    {
      entry.data.preview?.src && (
        <div class="absolute inset-0 h-full overflow-hidden">
          <img
            src={entry.data.preview.src}
            class="absolute blur-2xl inset-0 h-full w-full object-cover"
            alt=""
          />
        </div>
      )
    }

    {
      /*
        Rendered statically (no client: directive - zero JS shipped for it),
        so it's part of the very first HTML response and animates via CSS
        alone, unlike RouteMap below which needs JS to mount at all. Sitting
        earlier in the DOM than RouteMap means the live map's own opaque
        canvas naturally paints over it once that's ready - no isReady
        wiring needed here to hide it again. The animation itself (base
        opacity-0, 100ms delay, 200ms fade in, held via fill-mode: forwards)
        is what keeps it from flashing on a load fast enough that RouteMap
        covers it before the delay even elapses.
      */
    }
    <div
      aria-hidden="true"
      class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 animate-[spinner-appear_200ms_ease-out_100ms_forwards]"
    >
      <MapLoadingSpinner />
    </div>

    <RouteMap client:only="preact" route={geojson.data} />

    <a
      href={`/routes/${route}/`}
      aria-label="Minimise map"
      class="absolute top-2 right-2"
    >
      <Icon
        name="mdi:arrow-collapse"
        class="w-8 h-8 text-white bg-green-500 rounded-full p-1 opacity-75 hover:opacity-100 transition-opacity"
      />
    </a>

    <div class="absolute bottom-0 left-0 w-96 bg-green-50">
      <FullElevationChart client:load points={attitudes} />
    </div>
  </div>

  <div id="escape-nav" data-route={route} aria-hidden="true" class="hidden">
  </div>

  <script>
    import { navigate } from "astro:transitions/client";

    document.addEventListener("astro:page-load", () => {
      const escapeNav = document.getElementById("escape-nav");
      const route = escapeNav?.dataset.route;

      if (!route) return;

      function onKeyDown(event: KeyboardEvent) {
        if (event.key === "Escape") {
          navigate(`/routes/${route}/`);
        }
      }

      document.addEventListener("keydown", onKeyDown);

      document.addEventListener(
        "astro:before-swap",
        () => {
          document.removeEventListener("keydown", onKeyDown);
        },
        { once: true },
      );
    });
  </script>

  <style is:global>
    .maplibregl-map {
      height: 100%;
      width: 100%;
    }
  </style>
</Layout>
