---
import Layout from "../layouts/Layout.astro";
import FoodListCardItem from "../components/ui/ListCardItem/Food.astro";
import places from "../content/food.json";

const icons: Record<string, string> = {
  Breakfast: "mdi:silverware",
  "Lunch/Dinner": "mdi:silverware-fork-knife",
  Cafe: "mdi:coffee",
};
---

<Layout title="The best places to eat in Gdańsk, Sopot, and Gdynia">
  <div
    class="max-w-(--breakpoint-xl) mx-auto relative px-2 lg:px-0"
    transition:name="map"
  >
    {
      ["Breakfast", "Lunch/Dinner", "Cafe"].map((category) => (
        <div class="my-4">
          <h2 class="text-2xl mb-3">{category}</h2>
          <ul>
            {places
              .filter((p) => p.kind === category)
              .map((place) => (
                <FoodListCardItem
                  link={place.link}
                  name={place.name}
                  location={place.location}
                  icon={icons[place.kind]}
                />
              ))}
          </ul>
        </div>
      ))
    }
  </div>
</Layout>
