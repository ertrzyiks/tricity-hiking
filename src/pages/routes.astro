---
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { merge } from "../services/merge";
import { enhance } from "../services/enhance";
import { getLineStringFeature } from "../services/getLineStringFeature";
import { sortRoutes } from "../services/sortRoutes";
import RouteListItem from "../components/ui/ListCardItem/Route.astro";

import mapImage from "../assets/home-map.jpg";
import { HomeMap } from "../components/ui/HomeMap/HomeMap";

const allRoutes = await getCollection("routes");
const routes = allRoutes.filter((route) => {
  return !route.data.draft;
});
const tricityRoutes = sortRoutes(
  routes.filter((route) => route.data.group === "tricity"),
);

const geojsonList = [];
const routeItems = [];

for (const [index, route] of tricityRoutes.entries()) {
  const number = index + 1;
  const geojson = await getEntry(route.data.geojson);
  const enhancedGeojson = enhance({
    collection: geojson.data,
    route: route.data,
  });

  // Tag each route's line with its trail number so the overview map can
  // render a matching numbered marker for it.
  const numberedGeojson = {
    ...enhancedGeojson,
    features: enhancedGeojson.features.map((feature) =>
      feature.geometry.type === "LineString"
        ? {
            ...feature,
            properties: { ...feature.properties, routeNumber: number },
          }
        : feature,
    ),
  };

  geojsonList.push(numberedGeojson);
  routeItems.push({
    route,
    number,
    properties:
      getLineStringFeature({ collection: enhancedGeojson })?.properties ?? {},
  });
}

const geojson = merge(geojsonList);
---

<Layout title="Map of the best hiking trails near Gdańsk, Sopot, and Gdynia">
  <div
    class="max-w-(--breakpoint-xl) mx-auto relative h-[70vh] px-2 lg:px-0"
    transition:name="map"
  >
    <div class="absolute inset-0 h-full overflow-hidden">
      <img src={mapImage.src} class="absolute blur-2xl inset-0 h-full" />
    </div>

    <HomeMap client:only="preact" routes={geojson} />
  </div>

  <div class="max-w-(--breakpoint-xl) mx-auto relative px-2 lg:px-0">
    <ul>
      {
        routeItems.map(({ route, number, properties }) => (
          <RouteListItem
            route={route}
            number={number}
            properties={properties}
          />
        ))
      }
    </ul>
  </div>
</Layout>

<style is:global>
  .maplibregl-map {
    height: 100%;
    width: 100%;
  }
</style>
