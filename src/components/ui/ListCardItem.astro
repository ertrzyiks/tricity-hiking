---
const { link, outlined = false } = Astro.props;

const securityProps = link.startsWith("http")
  ? { target: "_blank", rel: "noopener" }
  : {};
---

<li
  class:list={[
    "w-full group",
    outlined
      ? "border border-solid border-slate-200 rounded-lg"
      : "my-4 border-b border-solid border-slate-200 last:border-0",
  ]}
>
  <a
    class:list={[
      "grid grid-cols-[80px_1fr] py-4",
      outlined && "px-4",
    ]}
    href={link}
    {...securityProps}
  >
    <div class="row-span-1 sm:row-span-2">
      <slot name="image" />
    </div>

    <div class="ml-4">
      <div class="text-2xl">
        <slot name="title" />
      </div>

      {
        Astro.slots.has("description") && (
          <div class="text-l text-slate-500">
            <slot name="description" />
          </div>
        )
      }
    </div>

    <div class="col-span-full sm:col-auto px-4 py-4">
      <slot name="attributes" />
    </div>
  </a>
</li>
