---
const { title, description } = Astro.props;
import Deco from "../../assets/deco.svg";

const TRAIL_TRACK_COUNT = 3;
const trailTracks = Array.from({ length: TRAIL_TRACK_COUNT }, (_, i) => i);
---

<div class="bg-linear-45 from-green-700 via-green-600 to-green-700">
  <div
    id="hero-trail"
    class="relative h-14 lg:h-20 overflow-hidden"
    aria-hidden="true"
    data-track-count={TRAIL_TRACK_COUNT}
  >
    <svg viewBox="0 0 1000 120" preserveAspectRatio="none" class="absolute inset-0 w-full h-full">
      {
        trailTracks.map((i) => (
          <>
            <mask id={`hero-trail-mask-${i}`}>
              <rect id={`hero-trail-reveal-${i}`} x="0" y="0" width="1000" height="120" fill="white" />
            </mask>
            <path
              id={`hero-trail-path-${i}`}
              d=""
              fill="none"
              stroke="white"
              stroke-opacity="0.35"
              stroke-width="3"
              stroke-linecap="round"
              stroke-dasharray="5 16"
              mask={`url(#hero-trail-mask-${i})`}
              vector-effect="non-scaling-stroke"
            />
          </>
        ))
      }
    </svg>
    {
      trailTracks.map((i) => (
        <>
          {/* Dots live outside the SVG's stretched viewBox (it uses
              preserveAspectRatio="none" so the trail fills the strip) so
              they stay perfectly round instead of scaling into ellipses. */}
          <div
            id={`hero-trail-start-${i}`}
            class="absolute w-2 h-2 lg:w-2.5 lg:h-2.5 rounded-full bg-white/35 opacity-0"
            style="left: 0; top: 0; transform: translate(-50%, -50%)"
          />
          <div
            id={`hero-trail-end-${i}`}
            class="absolute w-2 h-2 lg:w-2.5 lg:h-2.5 rounded-full bg-white/35 opacity-0"
            style="left: 0; top: 0; transform: translate(-50%, -50%)"
          />
        </>
      ))
    }
  </div>

  <div
    class="max-w-(--breakpoint-xl) mx-auto relative px-4 lg:px-0 py-12 lg:py-24 flex flex-col lg:flex-row items-center gap-12"
  >
    <div class="flex-1">
      <h1 class="text-2xl lg:text-4xl text-slate-100 mb-8 max-w-78">{title}</h1>
      <h2 class="text-l lg:text-xl text-slate-100 max-w-120">{description}</h2>
    </div>
    <div class="px-5">
      <a
        id="hero-get-started-btn"
        href="/routes"
        class="bg-slate-100 block text-green-700 py-3 px-8 rounded text-2xl"
      >
        Get Started
      </a>
    </div>
  </div>

  <div class="h-[12vh] overflow-hidden">
    <Deco class="text-slate-50 w-full h-full relative -bottom-1" />
  </div>
</div>

<script>
  import { trackEvent } from "../../services/analytics";

  document.addEventListener("astro:page-load", () => {
    const getStartedBtn = document.getElementById("hero-get-started-btn");
    if (getStartedBtn) {
      getStartedBtn.addEventListener("click", () => {
        trackEvent("clicked homeHeroCTA");
      });
    }
  });
</script>

<script>
  // Decorative "hiking trail" animation drawn across the top of the hero.
  // Several tracks run at once, each independently and out of sync: a
  // start point fades in, a curvy dashed line draws itself over to an end
  // point, it holds for a beat, then fades out and starts again from a
  // new, randomly placed pair of points somewhere else in the strip.

  const VIEWBOX_WIDTH = 1000;
  const VIEWBOX_HEIGHT = 120;

  let stopAnimations: (() => void) | null = null;

  const rand = (min: number, max: number) => Math.random() * (max - min) + min;
  const pickSign = () => (Math.random() < 0.5 ? -1 : 1);

  // Builds a wobbly (never straight) path between two points. Half the
  // time it's a simple bulging curve, half the time a wavier S-curve, so
  // the trails don't all look the same.
  function makeTrailPath(x1: number, y1: number, x2: number, y2: number) {
    const dx = x2 - x1;

    if (Math.random() < 0.5) {
      const midX = x1 + dx / 2;
      const midY = rand(10, VIEWBOX_HEIGHT - 10) + pickSign() * rand(30, 85);
      return `M ${x1} ${y1} Q ${midX} ${midY} ${x2} ${y2}`;
    }

    const c1x = x1 + dx * rand(0.2, 0.4);
    const c1y = y1 + pickSign() * rand(30, 75);
    const c2x = x1 + dx * rand(0.6, 0.8);
    const c2y = y2 + pickSign() * rand(30, 75);
    return `M ${x1} ${y1} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${x2} ${y2}`;
  }

  function runTrail(index: number) {
    const path = document.getElementById(`hero-trail-path-${index}`);
    const reveal = document.getElementById(`hero-trail-reveal-${index}`);
    const startDot = document.getElementById(`hero-trail-start-${index}`);
    const endDot = document.getElementById(`hero-trail-end-${index}`);

    if (!path || !reveal || !startDot || !endDot) {
      return null;
    }

    let cancelled = false;
    const timeouts: ReturnType<typeof setTimeout>[] = [];
    const schedule = (fn: () => void, delay: number) => {
      timeouts.push(setTimeout(fn, delay));
    };

    const toPercent = (value: number, axisSize: number) => `${(value / axisSize) * 100}%`;

    function nextCycle() {
      if (cancelled) return;

      // Re-roll timings each cycle so tracks keep drifting apart rather
      // than settling into a synchronised loop.
      const drawDelay = 400;
      const drawDuration = rand(1400, 2200);
      const holdDuration = rand(700, 1300);
      const fadeDuration = 600;
      const pauseBeforeNext = rand(400, 1800);

      // Most trails run left-to-right, but sometimes reverse so the walk
      // isn't always in the same direction.
      const reversed = Math.random() < 0.3;

      const margin = 80;
      const leftX = rand(margin, VIEWBOX_WIDTH * 0.35);
      const rightX = rand(VIEWBOX_WIDTH * 0.65, VIEWBOX_WIDTH - margin);
      const x1 = reversed ? rightX : leftX;
      const x2 = reversed ? leftX : rightX;
      const y1 = rand(5, VIEWBOX_HEIGHT - 5);
      const y2 = rand(5, VIEWBOX_HEIGHT - 5);

      path!.setAttribute("d", makeTrailPath(x1, y1, x2, y2));
      path!.style.transition = "";
      path!.style.opacity = "1";

      // The reveal rect covers the full strip at all times; a scaleX
      // transform grows it out from the start edge (left for a
      // left-to-right trail, right for a reversed one) to uncover the
      // dashed path in the direction it's being "walked".
      reveal!.style.transformOrigin = reversed ? "100% 50%" : "0% 50%";
      reveal!.style.transition = "none";
      reveal!.style.transform = "scaleX(0)";

      startDot!.style.left = toPercent(x1, VIEWBOX_WIDTH);
      startDot!.style.top = toPercent(y1, VIEWBOX_HEIGHT);
      endDot!.style.left = toPercent(x2, VIEWBOX_WIDTH);
      endDot!.style.top = toPercent(y2, VIEWBOX_HEIGHT);
      startDot!.style.transition = "none";
      endDot!.style.transition = "none";
      startDot!.style.opacity = "0";
      endDot!.style.opacity = "0";

      // 1. Reveal the start point.
      requestAnimationFrame(() => {
        if (cancelled) return;
        startDot!.style.transition = "opacity 400ms ease";
        startDot!.style.opacity = "1";
      });

      // 2. Draw the curvy dashed line towards the end point.
      schedule(() => {
        if (cancelled) return;
        reveal!.style.transition = `transform ${drawDuration}ms ease-in-out`;
        reveal!.style.transform = "scaleX(1)";
      }, drawDelay);

      // 3. Reveal the end point once the line has finished drawing.
      schedule(() => {
        if (cancelled) return;
        endDot!.style.transition = "opacity 400ms ease";
        endDot!.style.opacity = "1";
      }, drawDelay + drawDuration);

      // 4. Hold, then fade the whole thing out.
      schedule(() => {
        if (cancelled) return;
        const fade = `opacity ${fadeDuration}ms ease`;
        path!.style.transition = fade;
        startDot!.style.transition = fade;
        endDot!.style.transition = fade;
        path!.style.opacity = "0";
        startDot!.style.opacity = "0";
        endDot!.style.opacity = "0";
      }, drawDelay + drawDuration + holdDuration);

      // 5. Start the next line, in a new spot.
      schedule(
        nextCycle,
        drawDelay + drawDuration + holdDuration + fadeDuration + pauseBeforeNext,
      );
    }

    // Stagger this track's very first run so tracks don't all start together.
    schedule(nextCycle, rand(0, 2500));

    return () => {
      cancelled = true;
      timeouts.forEach(clearTimeout);
    };
  }

  function runHeroTrailAnimations() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return null;
    }

    const container = document.getElementById("hero-trail");
    const trackCount = Number(container?.dataset.trackCount) || 0;

    const stops: Array<() => void> = [];
    for (let i = 0; i < trackCount; i++) {
      const stop = runTrail(i);
      if (stop) stops.push(stop);
    }

    if (stops.length === 0) return null;

    return () => stops.forEach((stop) => stop());
  }

  document.addEventListener("astro:page-load", () => {
    stopAnimations?.();
    stopAnimations = runHeroTrailAnimations();
  });

  document.addEventListener("astro:before-swap", () => {
    stopAnimations?.();
    stopAnimations = null;
  });
</script>
