---
const { title, description } = Astro.props;
import Deco from "../../assets/deco.svg";
---

<div class="bg-linear-45 from-green-700 via-green-600 to-green-700">
  <div class="h-14 lg:h-20 overflow-hidden" aria-hidden="true">
    <svg
      id="hero-trail"
      viewBox="0 0 1000 120"
      preserveAspectRatio="none"
      class="w-full h-full"
    >
      <mask id="hero-trail-mask">
        <rect id="hero-trail-reveal" x="0" y="0" width="0" height="120" fill="white" />
      </mask>
      <path
        id="hero-trail-path"
        d=""
        fill="none"
        stroke="white"
        stroke-opacity="0.35"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="10 8"
        mask="url(#hero-trail-mask)"
        vector-effect="non-scaling-stroke"
      ></path>
      <circle id="hero-trail-start" cx="0" cy="0" r="5" fill="white" fill-opacity="0.35" opacity="0"
      ></circle>
      <circle id="hero-trail-end" cx="0" cy="0" r="5" fill="white" fill-opacity="0.35" opacity="0"
      ></circle>
    </svg>
  </div>

  <div
    class="max-w-(--breakpoint-xl) mx-auto relative px-4 lg:px-0 py-12 lg:py-24 flex flex-col lg:flex-row items-center gap-12"
  >
    <div class="flex-1">
      <h1 class="text-2xl lg:text-4xl text-slate-100 mb-8 max-w-78">{title}</h1>
      <h2 class="text-l lg:text-xl text-slate-100 max-w-120">{description}</h2>
    </div>
    <div class="px-5">
      <a
        id="hero-get-started-btn"
        href="/routes"
        class="bg-slate-100 block text-green-700 py-3 px-8 rounded text-2xl"
      >
        Get Started
      </a>
    </div>
  </div>

  <div class="h-[12vh] overflow-hidden">
    <Deco class="text-slate-50 w-full h-full relative -bottom-1" />
  </div>
</div>

<script>
  import { trackEvent } from "../../services/analytics";

  document.addEventListener("astro:page-load", () => {
    const getStartedBtn = document.getElementById("hero-get-started-btn");
    if (getStartedBtn) {
      getStartedBtn.addEventListener("click", () => {
        trackEvent("clicked homeHeroCTA");
      });
    }
  });
</script>

<script>
  // Decorative "hiking trail" animation drawn across the top of the hero:
  // a start point appears, a curvy dashed line draws itself to an end
  // point, it holds for a beat, then fades out and starts again from a
  // new, randomly placed pair of points.
  let stopAnimation: (() => void) | null = null;

  function runHeroTrailAnimation() {
    const svg = document.getElementById("hero-trail");
    const path = document.getElementById("hero-trail-path");
    const reveal = document.getElementById("hero-trail-reveal");
    const startDot = document.getElementById("hero-trail-start");
    const endDot = document.getElementById("hero-trail-end");

    if (!svg || !path || !reveal || !startDot || !endDot) {
      return null;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return null;
    }

    const VIEWBOX_WIDTH = 1000;
    const VIEWBOX_HEIGHT = 120;

    const DRAW_DELAY = 500;
    const DRAW_DURATION = 1600;
    const HOLD_DURATION = 900;
    const FADE_DURATION = 600;
    const PAUSE_BEFORE_NEXT = 700;

    let cancelled = false;
    const timeouts: ReturnType<typeof setTimeout>[] = [];
    const schedule = (fn: () => void, delay: number) => {
      timeouts.push(setTimeout(fn, delay));
    };

    const rand = (min: number, max: number) => Math.random() * (max - min) + min;

    function nextCycle() {
      if (cancelled) return;

      const margin = 80;
      const x1 = rand(margin, VIEWBOX_WIDTH * 0.35);
      const x2 = rand(VIEWBOX_WIDTH * 0.65, VIEWBOX_WIDTH - margin);
      const y1 = rand(30, VIEWBOX_HEIGHT - 30);
      const y2 = rand(30, VIEWBOX_HEIGHT - 30);
      const midX = (x1 + x2) / 2;
      const bulge = rand(-40, 40);
      const controlY = rand(10, VIEWBOX_HEIGHT - 10);

      path!.setAttribute("d", `M ${x1} ${y1} Q ${midX + bulge} ${controlY} ${x2} ${y2}`);
      path!.style.transition = "";
      path!.style.opacity = "1";

      reveal!.style.transition = "none";
      reveal!.setAttribute("width", "0");

      startDot!.setAttribute("cx", String(x1));
      startDot!.setAttribute("cy", String(y1));
      endDot!.setAttribute("cx", String(x2));
      endDot!.setAttribute("cy", String(y2));
      startDot!.style.transition = "none";
      endDot!.style.transition = "none";
      startDot!.style.opacity = "0";
      endDot!.style.opacity = "0";

      // 1. Reveal the start point.
      requestAnimationFrame(() => {
        if (cancelled) return;
        startDot!.style.transition = "opacity 400ms ease";
        startDot!.style.opacity = "1";
      });

      // 2. Draw the curvy dashed line towards the end point.
      schedule(() => {
        if (cancelled) return;
        reveal!.style.transition = `width ${DRAW_DURATION}ms ease-in-out`;
        reveal!.setAttribute("width", String(VIEWBOX_WIDTH));
      }, DRAW_DELAY);

      // 3. Reveal the end point once the line has finished drawing.
      schedule(() => {
        if (cancelled) return;
        endDot!.style.transition = "opacity 400ms ease";
        endDot!.style.opacity = "1";
      }, DRAW_DELAY + DRAW_DURATION);

      // 4. Hold, then fade the whole thing out.
      schedule(() => {
        if (cancelled) return;
        const fade = `opacity ${FADE_DURATION}ms ease`;
        path!.style.transition = fade;
        startDot!.style.transition = fade;
        endDot!.style.transition = fade;
        path!.style.opacity = "0";
        startDot!.style.opacity = "0";
        endDot!.style.opacity = "0";
      }, DRAW_DELAY + DRAW_DURATION + HOLD_DURATION);

      // 5. Start the next line, in a new spot.
      schedule(
        nextCycle,
        DRAW_DELAY + DRAW_DURATION + HOLD_DURATION + FADE_DURATION + PAUSE_BEFORE_NEXT,
      );
    }

    nextCycle();

    return () => {
      cancelled = true;
      timeouts.forEach(clearTimeout);
    };
  }

  document.addEventListener("astro:page-load", () => {
    stopAnimation?.();
    stopAnimation = runHeroTrailAnimation();
  });

  document.addEventListener("astro:before-swap", () => {
    stopAnimation?.();
    stopAnimation = null;
  });
</script>
