{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "test": "vitest",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "capture": "concurrently \"PUBLIC_ASTRO_USE_MAPTILER_MAP_STYLE=true DISABLE_WATCH=true astro dev\" \"sleep 10 && node scripts/capture.js\" --kill-others",
    "capture:preview": "PUBLIC_ASTRO_USE_MAPTILER_MAP_STYLE=true astro build --mode development && concurrently \"astro preview\" \"sleep 2 && node scripts/capture-route-preview.js\" --kill-others",
    "capture:map-tiles": "concurrently \"PUBLIC_ASTRO_USE_MAPTILER_MAP_STYLE=true DISABLE_WATCH=true astro dev\" \"sleep 10 && node scripts/capture-map-assets.js\" --kill-others",
    "draft2route": "node scripts/draft-to-route.js",
    "sync-route-order": "node scripts/sync-route-order.js",
    "gpx2json": "node scripts/gpx-to-json.js && prettier --write src/content/routes/*/*.json && prettier --write src/content/transportation/*.json",
    "test:checks": "checkly test",
    "deploy:checks": "checkly deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/preact": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@iconify-json/mdi": "1.2.3",
    "@nanostores/preact": "1.1.0",
    "@piwikpro/tracking-base-library": "1.7.1",
    "@sentry/astro": "10.69.0",
    "@statsig/js-client": "3.33.3",
    "@statsig/session-replay": "3.33.3",
    "@statsig/web-analytics": "3.33.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "astro-favicons": "3.1.6",
    "astro-icon": "1.1.5",
    "debounce": "3.0.0",
    "gantt-schedule-timeline-calendar": "3.43.14",
    "maplibre-gl": "6.1.0",
    "nanostores": "1.4.2",
    "playwright": "1.62.1",
    "preact": "10.29.8",
    "recharts": "3.10.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tmcw/togeojson": "7.1.2",
    "@xmldom/xmldom": "0.9.10",
    "checkly": "8.19.0",
    "concurrently": "10.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "puppeteer": "25.4.0",
    "vitest": "4.1.10"
  }
}
